<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="tests/.phpunit.cache"
         executionOrder="depends,defects"
         shortenArraysForExportThreshold="10"
         requireCoverageMetadata="true"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         failOnPhpunitDeprecation="true"
         failOnWarning="true">

    <coverage>
        <report>
            <clover outputFile="./tests/clover.xml"/>
            <html outputDirectory="tests/results"/>
        </report>
    </coverage>

    <php>
        <env name="IS_PHPUNIT__TEST" value="true"/>
        <env name="XDEBUG_MODE" value="coverage"/>
    </php>

    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

    <testsuites>
        <testsuite name="MailChimp API Test Suite">
            <directory phpVersion="8.3" phpVersionOperator=">=">tests/</directory>
        </testsuite>
    </testsuites>
</phpunit>
